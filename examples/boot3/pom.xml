<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.hozdemir</groupId>
    <artifactId>precognition-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>precognition-example-boot3</artifactId>
  <properties>
    <verification.tests>${project.basedir}/../../verification/src/test/java</verification.tests>
    <verification.output>${project.basedir}/target</verification.output>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.hozdemir</groupId>
      <artifactId>precognition-spring-boot3-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <directory>${verification.output}</directory>
    <sourceDirectory>${project.basedir}/../common/src/main/java</sourceDirectory>
    <testSourceDirectory>${verification.tests}</testSourceDirectory>
    <testResources>
      <testResource>
        <directory>${project.basedir}/../../verification/src/test/resources</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <failIfNoTests>true</failIfNoTests>
          <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
          <systemPropertyVariables>
            <verification.fixtureFile>${project.basedir}/../../target/validation/boot3-laravel-fixtures.json</verification.fixtureFile>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>3.5.16</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <profiles>
    <profile>
      <id>security-verification</id>
      <properties>
        <verification.tests>${project.basedir}/../../verification/src/security-test/java</verification.tests>
        <verification.output>${project.basedir}/target/security-verification</verification.output>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-security</artifactId>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>org.springframework.security</groupId>
          <artifactId>spring-security-test</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
